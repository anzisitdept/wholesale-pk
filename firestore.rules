rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Products: Public read for storefront, authenticated admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Categories: Public read & write so seeder and admin can sync categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 3. Store Content (Homepage banners, top bar): Public read, admin write
    match /store_content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Order Counters (Required for generating sequential order IDs like WSP-000001)
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // 5. Orders: Customers can submit orders (create); only authenticated admin can view & manage them
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 6. Customer Reviews: Public can read and submit reviews; admin can approve/reject
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // 7. Default rule for authenticated admins
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
